[Unit]
Description=Lunar Optimize (open-seo worker under local workerd) for optimize.projectlunar.ai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# The live release is whatever /opt/lunar-optimize/current points at (box-install.sh and rollback.sh
# flip it while the unit is stopped). Data in /opt/lunar-optimize/data is shared by every release.
WorkingDirectory=/opt/lunar-optimize/current/app
Environment=PATH=/opt/lunar-optimize/current/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/opt/lunar-optimize
Environment=XDG_CONFIG_HOME=/opt/lunar-optimize/.config
Environment=WRANGLER_SEND_METRICS=false
Environment=CI=1
ExecStartPre=/opt/lunar-optimize/current/bin/migrate.sh
ExecStart=/opt/lunar-optimize/current/bin/run.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
# Hard memory cap: Optimize is the process that gets reclaimed, never Studio. 512M stalled the service
# (2026-10-21); the box's memory.conf drop-in holds the same 800M/900M.
MemoryHigh=800M
MemoryMax=900M
MemorySwapMax=0
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
