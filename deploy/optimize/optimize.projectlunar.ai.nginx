# Lunar Optimize. Its own site file; certbot adds the 443 server and the redirect to this file only.
server {
    listen 80;
    listen [::]:80;
    server_name optimize.projectlunar.ai;

    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:3601;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade_lo;
        proxy_read_timeout 300s;
    }
}

map $http_upgrade $connection_upgrade_lo {
    default upgrade;
    ''      close;
}
