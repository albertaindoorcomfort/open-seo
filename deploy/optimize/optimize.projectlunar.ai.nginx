# Lunar Optimize. Its own site file; certbot adds the 443 server and the redirect to this file only.
server {
    server_name optimize.projectlunar.ai;

    client_max_body_size 16m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        proxy_pass http://127.0.0.1:3601;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade_lo;
        proxy_read_timeout 300s;
    }

    # P0-2, scheduled work. Only the box's own timers trigger it, on 127.0.0.1:3601; /health/* stays public.
    # The app and wrangler read paths the WHATWG way ("\" is "/", "#" starts a fragment) and nginx does not,
    # so /assets/..\internal\cron would slip past the prefix blocks below. Browsers never put either raw in
    # a path; the query string is left alone.
    if ($request_uri ~ "^[^?]*[\\\\#]") {
        return 400;
    }
    # The app's own trigger (Bearer secret) and wrangler dev's unauthenticated /cdn-cgi/handler/scheduled.
    # No Cloudflare edge fronts this box, so nothing legitimate uses /cdn-cgi/ here.
    location ^~ /internal/ {
        return 404;
    }
    location ^~ /cdn-cgi/ {
        return 404;
    }

    # Hashed build assets. add_header here replaces the server-level set, so it is repeated.
    location ^~ /assets/ {
        proxy_pass http://127.0.0.1:3601;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    listen [::]:443 ssl http2; # managed by Certbot
    listen 443 ssl http2; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/optimize.projectlunar.ai/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/optimize.projectlunar.ai/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

map $http_upgrade $connection_upgrade_lo {
    default upgrade;
    ''      close;
}

server {
    if ($host = optimize.projectlunar.ai) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name optimize.projectlunar.ai;
    return 404; # managed by Certbot


}
